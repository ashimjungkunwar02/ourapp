# ── Lisa Sweeps backend environment ─────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# The server EXITS AT BOOT if JWT_SECRET or MONGODB_URI is missing. There are
# no fallback secrets anywhere in the codebase by design.

# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/lisa-sweeps

# JWT signing key. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin bootstrap credentials, used ONLY by `npm run create-admin`.
# Changing these does NOT change an existing admin's password — reset that
# through POST /api/admin/users/:id/reset-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# Origin allowed by CORS and by the Socket.io handshake.
CLIENT_URL=http://localhost:5173

# Web push (VAPID). If unset, push endpoints return 503 and the rest of the API
# still boots. Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lisasweeps.com
