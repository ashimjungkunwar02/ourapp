# Copy to `android/keystore.properties` (gitignored) for LOCAL release signing.
# CI does not use this file — it reads the KS_* environment variables instead.
#
# Generate a keystore once and keep it safe. Losing it means you can never ship
# an update to the same Play Store listing:
#
#   keytool -genkeypair -v \
#     -keystore lisa-sweeps-release.keystore \
#     -alias lisa-sweeps \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved by Gradle's `file()` inside app/build.gradle, i.e.
# RELATIVE TO frontend/android/app/ — not to frontend/ or frontend/android/.
# Easiest to avoid that trap: use an absolute path.
storeFile=/absolute/path/to/lisa-sweeps-release.keystore
storePassword=CHANGE_ME
keyAlias=lisa-sweeps
keyPassword=CHANGE_ME
