# ── Lisa Sweeps frontend environment ────────────────────────────────────────
# Copy to `.env` (or `.env.production`) and fill in real values.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle, so
# anything here is PUBLIC by design. The Supabase anon key is safe to publish —
# it is gated by Row Level Security. NEVER put the service_role key here; it
# belongs only in `supabase secrets set SERVICE_ROLE_KEY=...` for Edge Functions.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API. Both must be set or the app renders a
# "Supabase is not configured" error instead of a working UI.
#
#   URL looks like:  https://abcdefghijklm.supabase.co
#   anon key is a long JWT starting with "eyJ..."
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Native app (Capacitor / Android APK) ────────────────────────────────────
# The Capacitor build loads the site from the device via a local scheme, not
# from Cloudflare. Set this to your deployed Pages URL so a freshly built APK
# can still talk to Supabase over the network and use the same project:
#
#   VITE_SUPABASE_URL is enough; this variable is only used by the native
#   splash/deep-link config and is optional.
VITE_APP_ORIGIN=https://lisasweeps.pages.dev

# ── Service worker ──────────────────────────────────────────────────────────
# Registered in production builds only, since caching in front of the Vite dev
# server breaks HMR. Set to 'true' to exercise offline behaviour locally.
# On Android the SW is irrelevant — the native layer handles caching.
VITE_ENABLE_SW=false

# ── Removed by the Supabase migration (documented so old values don't get
#    re-added; the code no longer reads them) ────────────────────────────────
#   VITE_API_URL          — no Express server; the client talks to Supabase directly
#   VITE_SOCKET_URL       — Socket.io replaced by Supabase Realtime
#   VITE_VAPID_PUBLIC_KEY — web-push replaced by FCM on Android
