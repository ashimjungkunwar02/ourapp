# ── Lisa Sweeps frontend environment ────────────────────────────────────────
# Copy to `.env` (or `.env.production`) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle — so
# never put a secret here. Anything in this file is PUBLIC.

# ── API base URL ─────────────────────────────────────────────────────────────
# RECOMMENDED: a relative `/api`. The browser then calls its own origin and
# vite.config.js proxies /api to the backend in development; in production any
# reverse proxy that routes /api to the Node process works unchanged. No CORS.
#
# ALTERNATIVE: an absolute URL for a backend on a different origin. It MUST
# include the /api prefix:
#   VITE_API_URL=https://api.lisasweeps.com/api
VITE_API_URL=/api

# ── Socket.io base URL (no /api prefix) ──────────────────────────────────────
# Leave EMPTY to use the current page origin (works with the dev proxy and with
# a same-origin production deploy). Set it only when the socket server lives on
# a different origin:
#   VITE_SOCKET_URL=https://api.lisasweeps.com
VITE_SOCKET_URL=

# ── Web push ─────────────────────────────────────────────────────────────────
# VAPID public key; must match the backend's VAPID_PUBLIC_KEY. Public by design.
# Leave blank and the client fetches it from GET /api/push/vapid-public-key.
VITE_VAPID_PUBLIC_KEY=

# ── Service worker ───────────────────────────────────────────────────────────
# The SW is registered in production builds only, since caching in front of the
# Vite dev server breaks HMR. Set to 'true' to exercise push/offline locally.
VITE_ENABLE_SW=false
